@model IEnumerable<Exercicio13_Pedidos.Models.Pedido><h1>Sistema de Pedidos</h1><p><a href="/Pedido/Index">Todos</a> | <a href="/Pedido/EmPreparo">Em preparo</a> | <a href="/Pedido/Prontos">Prontos</a> | <a href="/Pedido/Entregues">Entregues</a> | <a href="/Pedido/Dashboard">Dashboard</a></p><table><tr><th>Cliente</th><th>Produto</th><th>Quantidade</th><th>Unitário</th><th>Total</th><th>Status</th></tr>@foreach(var p in Model){<tr><td>@p.Cliente</td><td>@p.Produto</td><td>@p.Quantidade</td><td>R$ @p.PrecoUnitario.ToString("N2")</td><td>R$ @p.Total.ToString("N2")</td><td>@p.Status</td></tr>}</table>
