@model IEnumerable<Exercicio13_Pedidos.Models.Pedido><h1>Dashboard</h1><p>Total de pedidos: <b>@Model.Count()</b></p><p>Valor total: <b>R$ @Model.Sum(x=>x.Total).ToString("N2")</b></p><p>Recebidos: @Model.Count(x=>x.Status=="Recebido")</p><p>Em preparo: @Model.Count(x=>x.Status=="Em preparo")</p><p>Prontos: @Model.Count(x=>x.Status=="Pronto")</p><p>Entregues: @Model.Count(x=>x.Status=="Entregue")</p>
