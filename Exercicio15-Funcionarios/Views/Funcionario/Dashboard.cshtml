@model IEnumerable<Exercicio15_Funcionarios.Models.Funcionario><h1>Dashboard</h1><p>Total: @Model.Count()</p><p>Ativos: @Model.Count(x=>x.Ativo)</p><p>Inativos: @Model.Count(x=>!x.Ativo)</p><p>Média salarial: R$ @Model.Average(x=>x.Salario).ToString("N2")</p><p>Maior salário: R$ @Model.Max(x=>x.Salario).ToString("N2")</p><p>Menor salário: R$ @Model.Min(x=>x.Salario).ToString("N2")</p><h2>Por departamento</h2><ul>@foreach(var g in Model.GroupBy(x=>x.Departamento)){<li>@g.Key: @g.Count()</li>}</ul>
