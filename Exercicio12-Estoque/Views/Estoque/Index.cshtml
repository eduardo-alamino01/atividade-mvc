@model IEnumerable<Exercicio12_Estoque.Models.Produto><h1>Sistema de Estoque</h1><p><a href="/Estoque/Index">Todos</a> | <a href="/Estoque/Baixo">Baixo</a> | <a href="/Estoque/Esgotados">Esgotados</a> | <a href="/Estoque/Alertas">Alertas</a></p><table><tr><th>Produto</th><th>Categoria</th><th>Estoque</th><th>Mínimo</th><th>Preço</th><th>Status</th></tr>@foreach(var p in Model){<tr><td>@p.Nome</td><td>@p.Categoria</td><td>@p.Estoque</td><td>@p.EstoqueMinimo</td><td>R$ @p.Preco.ToString("N2")</td><td>@p.Status</td></tr>}</table>
