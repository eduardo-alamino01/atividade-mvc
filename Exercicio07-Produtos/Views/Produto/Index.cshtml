@model IEnumerable<Exercicio07_Produtos.Models.Produto><h1>Catálogo de Produtos</h1><p><a href="/Produto/Disponiveis">Somente disponíveis</a></p><table><tr><th>Nome</th><th>Categoria</th><th>Estoque</th><th>Preço</th><th>Status</th></tr>@foreach(var p in Model){<tr><td>@p.Nome</td><td>@p.Categoria</td><td>@p.Estoque</td><td>R$ @p.Preco.ToString("N2")</td><td class="@(p.Estoque==0?"danger":"ok")">@(p.Estoque==0?"Produto esgotado":"Disponível")</td></tr>}</table>
